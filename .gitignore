*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
/cdx

# Bundled Python venv auto-provisioned for circular graphs (see CMakeLists.txt).
# NOTE: circular_plot.py itself is NOT ignored here - the real source lives
# at coverage/python_script/circular_plot.py and must stay tracked; a bare
# (path-less) "circular_plot.py" pattern would match it too (gitignore
# patterns without a leading slash match at every directory depth), which is
# exactly what happened before this comment existed: the real source file
# was silently never committed, so a fresh clone's build failed with
# "No rule to make target '.../circular_plot.py'". The *copies* CMake makes
# next to build outputs are already covered by the build-dir patterns above
# (cmake-build-*/, build/, build-*/), so no separate rule is needed for them.
pyenv/

# ==============================================================================
# Project-Specific Genomic / Data Files
# ==============================================================================
*.cdx
*.gam
*.gbz

# ==============================================================================
# Temporary Files & Logs
# ==============================================================================
*.tmp
*.log
*.bak
*.swp
*~

# ==============================================================================
# cdx run output (default filenames written by the coverage branch)
# ==============================================================================
/coverage_graph.png
/coverage_profile.tsv
/coverage_stats.txt
__pycache__/
output/

# ==============================================================================
# Third-party dependencies auto-fetched by CMake (FetchContent/ExternalProject)
# ==============================================================================
# CLI11, libbdsg, gbwt, gbwtgraph, sdsl-lite (builder/deps/) and libvgio
# (coverage/deps/) are downloaded automatically by `cmake configure`, pinned
# to an exact commit in each branch's CMakeLists.txt - never committed here.
builder/deps/
coverage/deps/
